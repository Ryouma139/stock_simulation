# このファイルを .env にコピーして値を書く（.env は Git の管理外。トークンをコミットしないため）
#   PowerShell:  Copy-Item .env.example .env

# Notion インテグレーションのシークレット（https://www.notion.so/profile/integrations で発行。ntn_ で始まる）
NOTION_TOKEN=

# PostgreSQL の接続 URL
#   ローカル（docker の stocksim-pg）: postgresql://stocksim:stocksim@localhost:5433/stocksim
#   Neon / Supabase                  : postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://stocksim:stocksim@localhost:5433/stocksim

# 株価DB 以外の Notion DB を同期するときだけ指定（省略時は 📈 株価DB）
# NOTION_DATABASE_ID=
